    },
    "only_prayer": {
     "file": "voices/cult1/only_prayer.wav",
     "text": "Dann heute ohne Räucherwerk. Nur das Gebet. Und lasst ihn so. Wenn er morgen wieder zu ist, weiß er, dass wir es wissen.",
     "filtered": "voices/cult1/only_prayer_recorder.wav",
     "filter": "Diktiergerät-Klang"
    }
   }
  },
  "cult2": {
