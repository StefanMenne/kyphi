  "lift_down_video": {
   "tool": "gb10-assets/generate_video",
   "version": "gb10-assets 1.1.1",
   "request": {
    "model": "ltx-2.5",
    "prompt": "Hand-drawn comic style, dark rocky elevator shaft seen from above. The camera stays high in the shaft and looks straight down while the octagonal steel elevator cabin with its warm orange lit glass windows and the man in a long brown coat inside starts to descend, slowly at first, then faster, sinking away from the camera deep into the narrow shaft, held by thick steel cables that stretch down into the depth. Small lamps on the rough rock walls flash past, the cabin becomes smaller and smaller until it is only a glowing orange dot far below, surrounded by a faint cold blue light at the bottom of the shaft. Dark, mysterious mood. Sounds: a heavy mechanical clunk as the brake releases, the deep hum of the electric winch, steel cables creaking and humming, a low rumble echoing through the shaft and fading into the depth.",
    "images": [
     "lift_down_start"
    ],
    "width": 1344,
    "height": 768,
    "duration_s": 8,
